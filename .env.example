# Ethereum Sepolia deployment settings.
# Never commit real private keys or RPC credentials.
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Optional source verification.
ETHERSCAN_API_KEY=

# Required only for live Nox smoke and multi-wallet E2E scripts.
NOX_HANDLE_GATEWAY_URL=
NOX_SUBGRAPH_URL=

# Dedicated live E2E wallets. Do not reuse the deployer for actors.
# Minimum live E2E setup is four distinct wallets total:
# deployer, actor 1, actor 2, and actor 3.
# Actor 3 is used as the collection recipient when no dedicated recipient key is set.
SEPOLIA_ACTOR_1_PRIVATE_KEY=
SEPOLIA_ACTOR_2_PRIVATE_KEY=
SEPOLIA_ACTOR_3_PRIVATE_KEY=

# Optional. Set only when testing with a fifth dedicated recipient wallet.
SEPOLIA_RECIPIENT_PRIVATE_KEY=
