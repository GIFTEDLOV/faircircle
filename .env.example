# Ethereum Sepolia deployment settings.
# Never commit real private keys or RPC credentials.
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Optional source verification.
ETHERSCAN_API_KEY=

# Required only for live Nox smoke and multi-wallet E2E scripts.
NOX_HANDLE_GATEWAY_URL=
NOX_SUBGRAPH_URL=

# Dedicated live E2E wallets. Do not reuse the deployer for these.
SEPOLIA_ACTOR_1_PRIVATE_KEY=
SEPOLIA_ACTOR_2_PRIVATE_KEY=
SEPOLIA_ACTOR_3_PRIVATE_KEY=
SEPOLIA_RECIPIENT_PRIVATE_KEY=
