{
  "name": "faircircle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev:frontend": "pnpm --dir frontend dev",
    "lint:frontend": "pnpm --dir frontend lint",
    "build:frontend": "pnpm --dir frontend build",
    "compile:contracts": "pnpm --dir contracts compile",
    "test:contracts": "pnpm --dir contracts test",
    "check:size": "pnpm --dir contracts check:size",
    "demo:quiet-budget": "pnpm --dir contracts demo:quiet-budget",
    "demo:fair-split": "pnpm --dir contracts demo:fair-split",
    "demo:private-circle": "pnpm --dir contracts demo:private-circle",
    "demo:plan-together": "pnpm --dir contracts demo:plan-together",
    "preflight:sepolia": "pnpm --dir contracts preflight:sepolia",
    "deploy:sepolia": "pnpm --dir contracts deploy:sepolia",
    "verify:sepolia": "pnpm --dir contracts verify:sepolia",
    "smoke:sepolia": "pnpm --dir contracts smoke:sepolia",
    "live-e2e:sepolia": "pnpm --dir contracts live-e2e:sepolia",
    "verify": "pnpm lint:frontend && pnpm build:frontend && pnpm compile:contracts && pnpm test:contracts && pnpm check:size"
  }
}
