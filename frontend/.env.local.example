# Safe browser-visible configuration for the FairCircle frontend.
# Every NEXT_PUBLIC value is bundled into client code and can be seen by browser users.
# Do not put private keys, private RPC credentials, root .env values, or personal secret URLs here.

# Optional for development. If unset, the frontend uses a public Sepolia RPC fallback
# suitable for read-only health checks but not guaranteed for production traffic.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Required for production QuietBudget room history discovery.
# Server-only: may contain a private provider credential and must never use NEXT_PUBLIC.
# The browser does not receive this value. Keep frontend/.env.local uncommitted.
SEPOLIA_RPC_URL=

# Required before browser Nox Handle clients can be created.
# These endpoints are public client configuration, not private wallet credentials.
NEXT_PUBLIC_NOX_HANDLE_GATEWAY_URL=
NEXT_PUBLIC_NOX_SUBGRAPH_URL=
